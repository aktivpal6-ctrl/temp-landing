REACT_APP_BACKEND_URL=https://aktivpal-landing.preview.emergentagent.com
WDS_SOCKET_PORT=443
ENABLE_HEALTH_CHECK=false

MONGO_URI=

ADMIN_PASSWORD=
ADMIN_SECRET=

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Gmail SMTP — use a Google App Password (not your regular password)
# Steps: Google Account → Security → 2-Step Verification → App passwords → Generate
GOOGLE_EMAIL=
GOOGLE_APP_PASSWORD=

# IndexNow: tells Bing, Yandex and other IndexNow search engines when blog posts or
# events change. Set it only on the live site. 8-128 letters, digits or hyphens,
# e.g. from `openssl rand -hex 16`. Leave empty to turn notifications off.
INDEXNOW_KEY=
